# Phantom web platform — nginx reverse proxy example.
#
# Adjust the three server_name values, then obtain certificates, e.g.:
#   certbot --nginx -d api.example.com -d app.example.com -d admin.example.com
#
# HTTPS is mandatory for Telegram Mini Apps.

# --- API ----------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name api.example.com;

    # ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Basic abuse protection on auth + purchase endpoints.
    location ~ ^/api/v1/(auth|admin/auth|shop/purchases) {
        limit_req zone=phantom_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Mini App (Next.js) -------------------------------------------------
server {
    listen 443 ssl http2;
    server_name app.example.com;
    root /var/www/phantom-app;
    index index.html;

    location ^~ /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# --- Admin panel (static files) ------------------------------------------
server {
    listen 443 ssl http2;
    server_name admin.example.com;

    root /var/www/phantom-admin;
    index index.html;

    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;  # SPA fallback for client-side routing
    }
}

# Place inside the http{} block (e.g. /etc/nginx/conf.d/phantom-limits.conf):
# limit_req_zone $binary_remote_addr zone=phantom_auth:10m rate=5r/s;
